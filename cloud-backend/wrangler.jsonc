{
  "name": "toolnexa-metadata",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "ratelimits": [
    {
      "name": "METADATA_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "GLOBAL_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ]
}